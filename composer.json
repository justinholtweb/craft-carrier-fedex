{
    "name": "justinholtweb/craft-carrier-fedex",
    "description": "FedEx rates, labels, tracking, pickups and locations for Carrier.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "carrier",
        "shipping",
        "fedex"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-carrier",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-carrier/docs/fedex",
        "source": "https://github.com/justinholtweb/craft-carrier-fedex",
        "issues": "https://github.com/justinholtweb/craft-carrier-fedex/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.3.0",
        "justinholtweb/craft-carrier": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\carrierfedex\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Carrier for FedEx",
        "handle": "carrier-fedex",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-carrier/docs/fedex",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-carrier-fedex/main/CHANGELOG.md",
        "class": "justinholtweb\\carrierfedex\\Plugin"
    }
}
